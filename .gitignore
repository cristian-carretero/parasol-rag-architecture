# Virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.pyc

# Data — heavy directories stay local; the pre-computed artifacts that the
# Streamlit dashboard consumes ARE versioned so Streamlit Cloud can serve them.
data/*
!data/aggregated/
!data/dataset/
!data/screening/
!data/rul/

# Generated figures — heavy, regenerable from the pipeline
outputs/figures/

# Diagnostics — versioned by default (small text artifacts represent
# historical decisions: calibrated coefficients, audit summaries).
#
# Exception: per-cell forensic audits under cell_diagnosis/ can grow
# linearly with the number of audited cells, and their .parquet/.log
# outputs are regenerable via `python -m src.audit_cell_diagnosis`.
# We ignore those to keep the repository size bounded.
#
# IMPORTANT: outputs/diagnostics/**/*.json and *.txt are NOT ignored —
# the calibrated coefficient JSONs are inputs for modules 08 and 09.
outputs/diagnostics/cell_diagnosis/**/*.parquet
outputs/diagnostics/cell_diagnosis/**/*.log

# System or IDE files
.DS_Store
.vscode/
.idea/

# Streamlit agent skills (environment-specific symlinks)
.agents/skills/outputs/diagnostics/
